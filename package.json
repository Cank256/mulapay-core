{
  "name": "mulapay-core-api",
  "version": "0.1.0",
  "private": true,
  "description": "MulaPay Core API: merchants, money movement, double-entry ledger and compliance",
  "license": "UNLICENSED",
  "author": "Caleb Nkunze",
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "nest start --watch --entryFile main.api",
    "dev:worker": "nest start --watch --entryFile main.worker",
    "dev:consumer": "nest start --watch --entryFile main.consumer",
    "build": "rimraf dist && tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --coverage",
    "test:load": "node -e \"console.error('Load tests (k6) arrive in Phase 8. See docs/ARCHITECTURE.md.'); process.exit(1)\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "node -e \"console.error('No seeds exist in Phase 0. Seeds arrive with the ledger in Phase 2.'); process.exit(1)\"",
    "db:studio": "drizzle-kit studio",
    "openapi:export": "npm run build && node dist/scripts/openapi-export.js",
    "seed:admin": "npm run build && node dist/scripts/seed-admin.js"
  },
  "dependencies": {
    "@casl/ability": "^7.1.3",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "^13.0.2",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-ioredis": "^0.73.0",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/instrumentation-undici": "^0.35.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@scalar/fastify-api-reference": "^1.78.1",
    "argon2": "^0.45.2",
    "bullmq": "^5.81.5",
    "bullmq-otel": "^1.3.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ioredis": "^5.8.2",
    "nestjs-zod": "^5.6.0",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.6",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.16.22",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.0.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
